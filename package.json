{
  "name": "aura-historia-partner-connect",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev --use-localhost",
    "dev:tunnel": "shopify app dev",
    "config:use:prod": "shopify app config use prod",
    "deploy": "shopify app deploy",
    "deploy:prod": "shopify app deploy --config=prod --allow-updates",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "biome check --files-ignore-unknown=true .",
    "lint:fix": "biome check --write --unsafe --files-ignore-unknown=true .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-router/dev": "^7.12.0",
    "@react-router/fs-routes": "^7.12.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/shopify-app-react-router": "1.1.0",
    "@shopify/shopify-app-session-storage-prisma": "8.0.0",
    "isbot": "^5.1.31",
    "prisma": "^7.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@shopify/polaris-types": "1.0.1",
    "@types/node": "^22.18.8",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  },
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "jbruder"
}
