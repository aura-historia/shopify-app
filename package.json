{
  "name": "aura-historia-partner-connect",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev --use-localhost",
    "dev:tunnel": "shopify app dev",
    "config:use:prod": "shopify app config use prod",
    "cf-deploy": "npm run build && wrangler deploy",
    "deploy": "shopify app deploy",
    "deploy:prod": "shopify app deploy --config=prod --allow-updates",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "biome check --files-ignore-unknown=true .",
    "lint:fix": "biome check --write --unsafe --files-ignore-unknown=true .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "preview": "npm run build && wrangler dev",
    "cf-typegen": "wrangler types",
    "openapi:generate": "openapi-ts"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@react-router/dev": "^7.15.1",
    "@react-router/fs-routes": "^7.15.1",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/shopify-app-react-router": "^1.2.0",
    "@shopify/shopify-app-session-storage-kv": "^6.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.12.0",
    "turndown": "^7.2.4",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/vite-plugin": "^1.39.0",
    "@cloudflare/workers-types": "^4.20260528.1",
    "@hey-api/openapi-ts": "^0.97.3",
    "@shopify/polaris-types": "1.0.7",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "isbot": "^5.1.40",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "wrangler": "^4.95.0"
  },
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "bruderj15"
}
