{
  "name": "aura-historia-partner-connect",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev --use-localhost",
    "dev:tunnel": "shopify app dev",
    "config:use:prod": "shopify app config use prod",
    "cf-deploy": "npm run build && wrangler deploy",
    "deploy": "shopify app deploy",
    "deploy:prod": "shopify app deploy --config=prod --allow-updates",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run setup && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "biome check --files-ignore-unknown=true .",
    "lint:fix": "biome check --write --unsafe --files-ignore-unknown=true .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "preview": "npm run build && wrangler dev",
    "cf-typegen": "wrangler types"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@react-router/dev": "^7.15.1",
    "@react-router/fs-routes": "^7.15.1",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/shopify-app-react-router": "^1.2.0",
    "@shopify/shopify-app-session-storage-kv": "^6.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vite-plugin": "^1.37.1",
    "@cloudflare/workers-types": "^4.20260511.1",
    "@shopify/polaris-types": "1.0.1",
    "@types/node": "^25.9.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "isbot": "^5.1.40",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^6.3.6",
    "wrangler": "^4.92.0"
  },
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "bruderj15"
}
