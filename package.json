{
  "name": "aura-historia-partner-connect",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev --use-localhost",
    "dev:tunnel": "shopify app dev --config=tunnel",
    "config:use:prod": "shopify app config use prod",
    "cf-deploy": "npm run build && wrangler deploy",
    "deploy": "shopify app deploy",
    "deploy:prod": "shopify app deploy --config=prod --allow-updates",
    "start": "react-router-serve ./build/server/index.js",
    "docker-start": "npm run start",
    "setup": "node -e \"console.log('No setup required: Shopify sessions use Cloudflare KV.')\"",
    "lint": "biome check --files-ignore-unknown=true .",
    "lint:fix": "biome check --write --unsafe --files-ignore-unknown=true .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "npm run build && wrangler dev",
    "cf-typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false --strict-vars false",
    "openapi:generate": "openapi-ts"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@react-router/dev": "^7.18.0",
    "@react-router/fs-routes": "^7.18.0",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "@shopify/shopify-api": "^15.0.1",
    "@shopify/shopify-app-react-router": "^4.0.0",
    "@shopify/shopify-app-session-storage-kv": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.12.0",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "ajv": "^8.20.0",
    "isbot": "^5.2.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.14"
  },
  "overrides": {
    "p-map": "^4.0.0"
  },
  "author": "bruderj15"
}
