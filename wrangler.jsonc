{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-historia-shopify-connect",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true
  },
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "kv-session-storage"
    }
  ]
}
