{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-historia-shopify-connect",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true
  },
  "main": "./workers/app.ts",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aura-historia-db",
      "database_id": "<your-d1-id-from-the-creation-step>"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<your-namespace-id>"
    }
  ]
}
