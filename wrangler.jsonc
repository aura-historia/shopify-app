{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-historia-shopify-connect",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true,
    "redact_query_string": true
  },
  "main": "workers/app.ts",
  "durable_objects": {
    "bindings": [
      { "name": "SHOP_COORDINATOR", "class_name": "ShopCoordinator" },
      { "name": "CATALOG_IMPORTER", "class_name": "CatalogImporter" }
    ]
  },
  "migrations": [
    { "tag": "shop-coordinator-v1", "new_sqlite_classes": ["ShopCoordinator"] },
    { "tag": "catalog-importer-v1", "new_sqlite_classes": ["CatalogImporter"] }
  ],
  "assets": {
    "directory": "build/client"
  },
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "35d22f3199a94867a04c109ec5f2cce3"
    }
  ],
  "vars": {
    "SHOPIFY_API_VERSION": "2026-10",
    "SHOPIFY_APP_URL": "https://partner-connect.aura-historia.com",
    "SCOPES": "read_products,read_product_listings,read_locales,read_shipping",
    "AURA_HISTORIA_API_BASE_URL": "https://api.aura-historia.com",
    "AURA_HISTORIA_OAUTH_ENV": "prod",
    "AURA_HISTORIA_OAUTH_SCOPE": "listing-sources:read listing-sources:write product-listings:read product-listings:write",
    "AURA_HISTORIA_OAUTH_CLIENT_ID": "oc_01m5vyyghjecx8c43drb05hh4n"
  }
}
