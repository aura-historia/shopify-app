{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-historia-shopify-connect",
  "compatibility_date": "2026-05-11",
  "observability": {
    "enabled": true
  },
  "main": "workers/app.ts",
  "assets": {
    "directory": "build/client"
  },
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "35d22f3199a94867a04c109ec5f2cce3"
    }
  ],
  "vars": {
    "SHOPIFY_API_VERSION": "2026-04",
    "SHOPIFY_APP_URL": "https://partner-connect.aura-historia.com",
    "SCOPES": "read_products,read_locales",
    "AURA_HISTORIA_API_BASE_URL": "https://api.aura-historia.com",
    "AURA_HISTORIA_OAUTH_ENV": "prod",
    "AURA_HISTORIA_OAUTH_SCOPE": "products:write shops:manage",
    "AURA_HISTORIA_OAUTH_CLIENT_ID": "019eb09e-563a-7ad2-8e71-1ae86f8430ab"
  }
}
